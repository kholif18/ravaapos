<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>RavaaPOS | Forgot Password</title>
    <link rel="icon" type="image/x-icon" href="/assets/img/favicon/favicon.ico" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="assets/css/auth/forgot-password.css">
</head>
<body>
    <div class="login-container">
        <!-- Kolom Kiri -->
        <div class="hero-section">
            <div class="floating-element floating-1"></div>
            <div class="floating-element floating-2"></div>
            
            <div class="brand">
                <h1>Ravaa<span>POS</span></h1>
            </div>

            <div class="illustration-container">
                <svg width="250" height="250" viewBox="0 0 400 400" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="50" y="80" width="300" height="240" rx="20" fill="rgba(255,255,255,0.1)" stroke="rgba(255,255,255,0.3)" stroke-width="2"/>
                    <rect x="70" y="100" width="80" height="15" rx="5" fill="rgba(255,255,255,0.3)"/>
                    <rect x="160" y="100" width="120" height="15" rx="5" fill="rgba(255,255,255,0.2)"/>
                    <rect x="70" y="130" width="260" height="1" fill="rgba(255,255,255,0.2)"/>
                    
                    <!-- Email/Message icon -->
                    <circle cx="200" cy="200" r="60" fill="rgba(255,215,0,0.15)" stroke="#ffd700" stroke-width="2"/>
                    <rect x="165" y="185" width="70" height="40" rx="5" fill="none" stroke="#ffd700" stroke-width="2"/>
                    <polyline points="165,190 200,215 235,190" stroke="#ffd700" stroke-width="2" fill="none"/>
                    
                    <!-- Lock icon -->
                    <rect x="185" y="240" width="30" height="20" rx="3" fill="rgba(255,215,0,0.3)" stroke="#ffd700" stroke-width="1.5"/>
                    <path d="M190,240 L190,230 C190,224 195,220 200,220 C205,220 210,224 210,230 L210,240" stroke="#ffd700" stroke-width="1.5" fill="none"/>
                    
                    <text x="200" y="320" fill="rgba(255,255,255,0.6)" font-size="14" text-anchor="middle">Reset Password</text>
                </svg>
            </div>

            <div class="stats-cards">
                <div class="stat-card">
                    <i class="fas fa-clock"></i>
                    <h3>24/7</h3>
                    <p>Support Ready</p>
                </div>
                <div class="stat-card">
                    <i class="fas fa-shield-alt"></i>
                    <h3>Secure</h3>
                    <p>Data Protection</p>
                </div>
                <div class="stat-card">
                    <i class="fas fa-envelope"></i>
                    <h3>Fast</h3>
                    <p>Email Delivery</p>
                </div>
            </div>
        </div>

        <!-- Kolom Kanan - Forgot Password Form -->
        <div class="form-section">
            <div class="forgot-card">
                <a href="/login" class="back-link">
                    <i class="fas fa-arrow-left"></i> Back to Login
                </a>

                <div class="forgot-header">
                    <div class="icon">
                        <i class="fas fa-key"></i>
                    </div>
                    <h3>Forgot Password?</h3>
                    <p>Enter your email address and we'll send you a link to reset your password.</p>
                </div>

                <div id="alertContainer"></div>

                <form id="forgotPasswordForm">
                    <input type="hidden" name="_csrf" id="csrfField" value="<%= csrfToken %>">

                    <div class="input-group">
                        <label>Email Address</label>
                        <div class="input-wrapper">
                            <i class="fas fa-envelope"></i>
                            <input type="email" id="email" placeholder="Enter your registered email" required autofocus>
                        </div>
                    </div>

                    <button type="submit" class="reset-button" id="resetBtn">
                        <span>Send Reset Link</span>
                        <i class="fas fa-paper-plane"></i>
                    </button>
                </form>

                <div class="login-link">
                    Remember your password? <a href="/login">Sign In</a>
                </div>
            </div>
        </div>
    </div>

    <script src="assets/js/auth/forgot-password.js"></script>
</body>
</html>