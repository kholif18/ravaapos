<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>RavaaPOS | Futuristic Login</title>
    <!-- Google Fonts & Icons -->
     <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="assets/css/login-glass.css">
</head>
<body>

<div class="grid-bg"></div>
<div class="glow-orb orb1"></div>
<div class="glow-orb orb2"></div>
<div class="glow-orb orb3"></div>
<div class="spotlight" id="spotlight"></div>

<div class="glass-panel">
    <div class="card-inner">
        <div class="brand-wrapper">
            <div class="logo-icon">
                <i class="fas fa-cube"></i>
            </div>
            <span class="brand-text">RavaaPOS</span>
        </div>

        <!-- Dynamic alert container -->
        <div id="alertContainer"></div>

        <form id="futuristicLoginForm">
            <input type="hidden" name="_csrf" id="csrfField" value="<%= csrfToken %>">

            <div class="input-group-custom">
                <label><i class="fas fa-user-astronaut"></i> USERNAME / EMAIL</label>
                <div class="input-wrapper">
                    <span class="input-icon"><i class="fas fa-user"></i></span>
                    <input type="text" id="loginUsername" placeholder="username" autocomplete="username" required>
                </div>
            </div>

            <div class="input-group-custom">
                <label><i class="fas fa-key"></i> SECURE KEY</label>
                <div class="input-wrapper">
                    <span class="input-icon"><i class="fas fa-lock"></i></span>
                    <input type="password" id="loginPassword" placeholder="••••••••" autocomplete="current-password" required>
                    <span class="toggle-password" id="togglePassIcon"><i class="far fa-eye-slash"></i></span>
                </div>
            </div>

            <button type="submit" class="login-btn" id="loginBtn">
                <span>LOGIN SECURE</span>
                <i class="fas fa-arrow-right-to-bracket"></i>
            </button>
        </form>
    </div>
</div>

<script src="assets/js/auth/login-glass.js"></script>

</body>
</html>