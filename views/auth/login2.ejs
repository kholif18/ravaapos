<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>RavaaPOS | Next-Gen Login</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="assets/css/login-new.css">
</head>
<body>
    <canvas id="particleCanvas"></canvas>
    
    <div class="container">
        <div class="login-wrapper">
            <div class="floating-cards">
                <div class="float-card card1">
                    <i class="fas fa-chart-line"></i>
                    <span>+245%</span>
                </div>
                <div class="float-card card2">
                    <i class="fas fa-shopping-cart"></i>
                    <span>1,284</span>
                </div>
                <div class="float-card card3">
                    <i class="fas fa-users"></i>
                    <span>5.2k</span>
                </div>
            </div>
            
            <div class="login-card">
                <div class="brand-section">
                    <div class="logo-3d">
                        <i class="fas fa-store"></i>
                    </div>
                    <h1 class="brand-name">Ravaa<span>POS</span></h1>
                    <p class="tagline">Powering Modern Retail</p>
                </div>
                
                <div class="welcome-text">
                    <h2>Welcome Back</h2>
                    <p>Login to access your dashboard</p>
                </div>
                
                <div id="alertContainer"></div>
                
                <form id="loginForm">
                    <input type="hidden" name="_csrf" id="csrfField" value="<%= csrfToken %>">
                    
                    <div class="input-group">
                        <div class="input-icon">
                            <i class="fas fa-envelope"></i>
                        </div>
                        <div class="input-field">
                            <input type="text" id="username" required>
                            <label for="username">Username / Email</label>
                        </div>
                    </div>
                    
                    <div class="input-group">
                        <div class="input-icon">
                            <i class="fas fa-lock"></i>
                        </div>
                        <div class="input-field">
                            <input type="password" id="password" required>
                            <label for="password">Password</label>
                            <span class="toggle-pwd">
                                <i class="far fa-eye-slash"></i>
                            </span>
                        </div>
                    </div>
                    
                    <div class="options">
                        <label class="checkbox">
                            <input type="checkbox">
                            <span>Remember me</span>
                        </label>
                        <a href="#" class="forgot">Forgot Password?</a>
                    </div>
                    
                    <button type="submit" class="login-btn" id="loginBtn">
                        <span>Login</span>
                        <i class="fas fa-arrow-right"></i>
                    </button>
                </form>
                
                <div class="demo-creds">
                    <p>Demo Credentials:</p>
                    <div class="creds-buttons">
                        <button type="button" data-user="admin" data-pass="pos123" class="cred-btn">
                            <i class="fas fa-user-shield"></i> Admin
                        </button>
                        <button type="button" data-user="kasir" data-pass="pos789" class="cred-btn">
                            <i class="fas fa-user"></i> Kasir
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <script src="assets/js/auth/login-new.js"></script>
</body>
</html>