<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>RavaaPOS | Reset Password</title>
    <link rel="icon" type="image/x-icon" href="/assets/img/favicon/favicon.ico" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="assets/css/auth/reset-password.css">
</head>
<body>
    <div class="login-container">
        <!-- Kolom Kiri -->
        <div class="hero-section">
            <div class="floating-element floating-1"></div>
            <div class="floating-element floating-2"></div>
            
            <div class="brand">
                <h1>Ravaa<span>POS</span></h1>
            </div>

            <div class="illustration-container">
                <svg width="250" height="250" viewBox="0 0 400 400" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="50" y="80" width="300" height="240" rx="20" fill="rgba(255,255,255,0.1)" stroke="rgba(255,255,255,0.3)" stroke-width="2"/>
                    <rect x="70" y="100" width="80" height="15" rx="5" fill="rgba(255,255,255,0.3)"/>
                    <rect x="160" y="100" width="120" height="15" rx="5" fill="rgba(255,255,255,0.2)"/>
                    
                    <!-- Key and Lock icon for reset password -->
                    <circle cx="200" cy="200" r="60" fill="rgba(255,215,0,0.15)" stroke="#ffd700" stroke-width="2"/>
                    <rect x="175" y="210" width="50" height="35" rx="5" fill="none" stroke="#ffd700" stroke-width="2"/>
                    <path d="M185,210 L185,195 C185,187 192,180 200,180 C208,180 215,187 215,195 L215,210" stroke="#ffd700" stroke-width="2" fill="none"/>
                    <circle cx="200" cy="228" r="4" fill="#ffd700"/>
                    
                    <text x="200" y="310" fill="rgba(255,255,255,0.6)" font-size="14" text-anchor="middle">Reset Your Password</text>
                </svg>
            </div>

            <div class="stats-cards">
                <div class="stat-card">
                    <i class="fas fa-shield-alt"></i>
                    <h3>Secure</h3>
                    <p>Data Protection</p>
                </div>
                <div class="stat-card">
                    <i class="fas fa-clock"></i>
                    <h3>24/7</h3>
                    <p>Support</p>
                </div>
                <div class="stat-card">
                    <i class="fas fa-key"></i>
                    <h3>Easy</h3>
                    <p>Reset Process</p>
                </div>
            </div>
        </div>

        <!-- Kolom Kanan - Reset Password Form -->
        <div class="form-section">
            <div class="reset-card">
                <a href="/login" class="back-link">
                    <i class="fas fa-arrow-left"></i> Back to Login
                </a>

                <div class="reset-header">
                    <div class="icon">
                        <i class="fas fa-lock-open"></i>
                    </div>
                    <h3>Reset Password</h3>
                    <p>Please enter your new password below.</p>
                </div>

                <% if (locals.error || (typeof error !== 'undefined' && error)) { %>
                    <div class="alert-modern">
                        <i class="fas fa-exclamation-triangle"></i>
                        <span><%= typeof error === 'string' ? error : (locals.error || 'Terjadi kesalahan') %></span>
                    </div>
                <% } %>
                <% if (locals.success || (typeof success !== 'undefined' && success)) { %>
                    <div class="alert-modern success">
                        <i class="fas fa-check-circle"></i>
                        <span><%= typeof success === 'string' ? success : (locals.success || 'Berhasil') %></span>
                    </div>
                <% } %>

                <div id="alertContainer"></div>

                <form id="resetPasswordForm" action="/reset-password/<%= token %>" method="POST">
                    <input type="hidden" name="_csrf" id="csrfField" value="<%= csrfToken %>">

                    <div class="input-group">
                        <label>New Password</label>
                        <div class="input-wrapper">
                            <i class="fas fa-lock"></i>
                            <input type="password" id="password" name="password" placeholder="Enter new password" required autofocus>
                            <i class="fas fa-eye-slash toggle-password"></i>
                        </div>
                        <div class="password-requirements" id="passwordRequirements">
                            <span id="lengthReq"><i class="fas fa-circle"></i> 8+ characters</span>
                            <span id="upperReq"><i class="fas fa-circle"></i> Uppercase</span>
                            <span id="numberReq"><i class="fas fa-circle"></i> Number</span>
                        </div>
                    </div>

                    <div class="input-group">
                        <label>Confirm New Password</label>
                        <div class="input-wrapper">
                            <i class="fas fa-lock"></i>
                            <input type="password" id="confirmPassword" placeholder="Confirm new password" required>
                            <i class="fas fa-eye-slash toggle-password2"></i>
                        </div>
                    </div>

                    <button type="submit" class="reset-button" id="resetBtn">
                        <span>Reset Password</span>
                        <i class="fas fa-check-circle"></i>
                    </button>
                </form>

                <div class="login-link">
                    Remember your password? <a href="/login">Sign In</a>
                </div>
            </div>
        </div>
    </div>

    <script src="assets/js/auth/reset-password.js"></script>
</body>
</html>