<div class="row">
  <div class="col-lg-8 mb-4 order-0">
    <div class="card">
      <div class="d-flex align-items-end row">
        <div class="col-sm-7">
          <div class="card-body">
            <h5 class="card-title text-primary">Selamat Datang, <%= user.name %>! 🎉</h5>
            <p class="mb-2">
              Anda telah melakukan <span class="fw-bold"><%= stats.todayTransactions %></span> transaksi hari ini.
            </p>
            <% if (activeSession) { %>
              <div class="alert alert-success d-flex align-items-center mb-4" role="alert">
                <i class="bx bx-check-circle me-2"></i>
                <div>
                  Sesi kasir sedang terbuka (Mulai: <%= new Date(activeSession.openingTime).toLocaleTimeString('id-ID') %>)
                </div>
              </div>
            <% } else { %>
              <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
                <i class="bx bx-error-circle me-2"></i>
                <div>
                  Sesi kasir belum dibuka. <a href="/cashier/open" class="alert-link">Buka sesi sekarang</a> untuk mulai berjualan.
                </div>
              </div>
            <% } %>

            <a href="/reports" class="btn btn-sm btn-outline-primary">Lihat Laporan</a>
          </div>
        </div>
        <div class="col-sm-5 text-center text-sm-start">
          <div class="card-body pb-0 px-0 px-md-4">
            <img src="/assets/img/illustrations/man-with-laptop-light.png" height="140" alt="View Badge User" data-app-dark-img="illustrations/man-with-laptop-dark.png" data-app-light-img="illustrations/man-with-laptop-light.png" />
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-lg-4 col-md-4 order-1">
    <div class="row">
      <div class="col-lg-6 col-md-12 col-6 mb-4">
        <div class="card">
          <div class="card-body">
            <div class="card-title d-flex align-items-start justify-content-between">
              <div class="avatar flex-shrink-0">
                <img src="/assets/img/icons/unicons/chart-success.png" alt="chart success" class="rounded" />
              </div>
            </div>
            <span class="fw-semibold d-block mb-1">Pendapatan</span>
            <h4 class="card-title mb-2"><%= formatRupiah(stats.todayRevenue) %></h4>
          </div>
        </div>
      </div>
      <div class="col-lg-6 col-md-12 col-6 mb-4">
        <div class="card">
          <div class="card-body">
            <div class="card-title d-flex align-items-start justify-content-between">
              <div class="avatar flex-shrink-0">
                <img src="/assets/img/icons/unicons/wallet-info.png" alt="Credit Card" class="rounded" />
              </div>
            </div>
            <span>Transaksi</span>
            <h4 class="card-title text-nowrap mb-1"><%= stats.todayTransactions %></h4>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="row">
  <!-- Recent Sales -->
  <div class="col-md-6 col-lg-4 col-xl-4 order-0 mb-4">
    <div class="card h-100">
      <div class="card-header d-flex align-items-center justify-content-between pb-0">
        <div class="card-title mb-0">
          <h5 class="m-0 me-2">Transaksi Terakhir</h5>
        </div>
      </div>
      <div class="card-body mt-3">
        <ul class="p-0 m-0">
          <% recentSales.forEach(sale => { %>
          <li class="d-flex mb-4 pb-1">
            <div class="avatar flex-shrink-0 me-3">
              <span class="badge bg-label-primary p-2"><i class="bx bx-receipt"></i></span>
            </div>
            <div class="d-flex w-100 flex-wrap align-items-center justify-content-between gap-2">
              <div class="me-2">
                <h6 class="mb-0"><%= sale.invoiceNumber %></h6>
                <small class="text-muted"><%= sale.customer ? sale.customer.name : 'Umum' %></small>
              </div>
              <div class="user-progress d-flex align-items-center gap-1">
                <h6 class="mb-0"><%= formatRupiah(sale.total) %></h6>
              </div>
            </div>
          </li>
          <% }) %>
        </ul>
      </div>
    </div>
  </div>

  <!-- Low Stock -->
  <div class="col-md-6 col-lg-4 col-xl-4 order-1 mb-4">
    <div class="card h-100">
      <div class="card-header d-flex align-items-center justify-content-between pb-0">
        <div class="card-title mb-0">
          <h5 class="m-0 me-2">Stok Menipis</h5>
        </div>
      </div>
      <div class="card-body mt-3">
        <ul class="p-0 m-0">
          <% lowStockProducts.forEach(product => { %>
          <li class="d-flex mb-4 pb-1">
            <div class="avatar flex-shrink-0 me-3">
              <span class="badge bg-label-danger p-2"><i class="bx bx-error"></i></span>
            </div>
            <div class="d-flex w-100 flex-wrap align-items-center justify-content-between gap-2">
              <div class="me-2">
                <h6 class="mb-0"><%= product.name %></h6>
                <small class="text-muted"><%= product.code %></small>
              </div>
              <div class="user-progress d-flex align-items-center gap-1">
                <h6 class="mb-0 text-danger"><%= product.stock %> <%= product.unit %></h6>
              </div>
            </div>
          </li>
          <% }) %>
        </ul>
      </div>
    </div>
  </div>

  <!-- Quick Actions -->
  <div class="col-md-6 col-lg-4 col-xl-4 order-2 mb-4">
    <div class="card h-100">
      <div class="card-header d-flex align-items-center justify-content-between">
        <h5 class="card-title m-0 me-2">Aksi Cepat</h5>
      </div>
      <div class="card-body">
        <div class="d-grid gap-2">
          <a href="/" class="btn btn-primary">
            <i class="bx bx-cart me-1"></i> Buka POS (Kasir)
          </a>
          <a href="/cashier/open" class="btn btn-outline-primary">
            <i class="bx bx-lock-open me-1"></i> Buka Sesi Kasir
          </a>
          <a href="/cashier/close" class="btn btn-outline-danger">
            <i class="bx bx-lock me-1"></i> Tutup Sesi Kasir
          </a>
          <a href="/products/create" class="btn btn-outline-secondary">
            <i class="bx bx-plus me-1"></i> Tambah Produk Baru
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
