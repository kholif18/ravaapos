<!DOCTYPE html>
<html lang="en" class="light-style" dir="ltr" data-theme="theme-default">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <title>POS System | <%= title %></title>

    <meta name="csrf-token" content="<%= csrfToken %>">
    
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/assets/img/favicon/favicon.ico" />
    
    <!-- Fonts & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/assets/vendor/fonts/boxicons.css" />
    
    <!-- Core CSS (Sneat) -->
    <link rel="stylesheet" href="/assets/vendor/css/core.css" />
    <link rel="stylesheet" href="/assets/vendor/css/theme-default.css" />
    
    <!-- POS Custom CSS -->
    <!-- <link rel="stylesheet" href="/assets/css/pos.css" /> -->
    <link rel="stylesheet" href="/assets/css/pos.css" />
    <link rel="stylesheet" href="/assets/css/pos-payment-sheet.css" />
    
    <!-- Vendors CSS -->
    <link rel="stylesheet" href="/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.css" />
    
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body class="pos-body" data-tax-rate="<%= taxRate %>">
    
    <!-- DESKTOP LAYOUT: 2 KOLOM -->
    <div class="pos-desktop-layout">
        
        <!-- KOLOM KIRI: Cart Section -->
        <div class="pos-cart">
            <div class="pos-cart-header">
                <div class="pos-cart-title">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bx bx-cart"></i>
                        <span>Shopping Cart</span>

                        <span class="cart-invoice-badge"
                            id="currentInvoice">
                            <%= invoiceNumber %>
                        </span>
                    </div>

                    <div class="cart-badge-wrapper">
                        <span class="cart-badge-item" title="Jumlah produk">
                            <i class="bx bx-package"></i>
                            <span id="cartItemCount">0</span>
                        </span>
                        <span class="cart-badge-qty" title="Total unit">
                            <i class="bx bx-box"></i>
                            <span id="cartTotalQty">0</span>
                        </span>
                    </div>
                </div>
                <div class="pos-search-group">
                    <div class="input-group">
                        <span class="input-group-text bg-primary text-white border-0">
                            <i class="bx bx-barcode"></i>
                        </span>
                        <input type="text" 
                            class="form-control" 
                            id="searchProduct" 
                            placeholder="Scan barcode atau cari produk... " 
                            autocomplete="off">
                    </div>
                    <div id="searchDropdown" class="search-dropdown" style="display: none;">
                        <div class="search-dropdown-header">
                            <small>↑ ↓ pilih &nbsp;&nbsp; Enter tambah &nbsp;&nbsp; Esc tutup</small>
                        </div>
                        <div id="searchResultsList" class="search-dropdown-list"></div>
                    </div>
                </div>                
            </div>
            
            <!-- Cart Scroll Area -->
            <div class="pos-cart-scroll">
                <div id="cartItems">
                    <!-- Akan diisi oleh JavaScript -->
                </div>
            </div>
            
            <!-- Cart Summary -->
            <div class="pos-cart-summary">
                <div class="pos-summary-card">
                    <div class="pos-summary-row">
                        <span class="text-muted">Subtotal</span>
                        <span id="subtotal">Rp 0</span>
                    </div>
                    <div class="pos-summary-row">
                        <span class="text-muted">Tax</span>
                        <span id="taxAmount">Rp 0</span>
                    </div>
                    <div class="pos-summary-row">
                        <span class="text-muted d-flex align-items-center gap-1">
                            Discount
                            <span class="badge bg-label-primary">Ctrl+D</span>
                        </span>
                        <div class="pos-discount-input">
                            <div class="input-group input-group-sm">
                                <input type="number" class="form-control text-end" id="discountInput" value="0" min="0" step="1000">
                                <span class="input-group-text">Rp</span>
                            </div>
                        </div>
                    </div>
                    <div class="pos-summary-row pos-summary-total">
                        <span>Total</span>
                        <span id="total">Rp 0</span>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- KOLOM KANAN: Action Panel Desktop -->
        <div class="pos-actions-desktop">
            <!-- Status Bar Desktop -->
            <div class="pos-status-bar">
                <div class="pos-status-left">
                    <div class="status-item">
                        <i class="bx bx-user-circle"></i>
                        <span id="cashierName">Kasir: <%= locals.user ? locals.user.fullName : 'Admin' %></span>
                    </div>
                    <div class="status-item">
                        <i class="bx bx-time"></i>
                        <span id="currentTime"></span>
                    </div>
                    <div class="status-item" id="transactionStatus">
                        <i class="bx bx-check-circle text-success"></i>
                        <span>Active</span>
                    </div>
                </div>
                <div class="pos-status-right">
                    <button class="btn-menu-in-status" id="openSlidePanelBtn" title="Menu (Reports, Settings, dll)">
                        <i class="bx bx-menu"></i>
                        <span>Menu</span>
                        <kbd>F8</kbd>
                    </button>
                </div>
            </div>
            
            <!-- Customer Section -->
            <div class="pos-customer-section">
                <div class="customer-selector-card" id="customerSelectorCard">
                    <input type="hidden" id="customerId" value="">
                    
                    <div class="customer-selector-header">
                        <div class="customer-info">
                            <div class="customer-selector-label">
                                <i class="bx bx-user"></i>
                                <span>Customer</span>
                                <kbd>F2</kbd>
                            </div>
                            <div class="selected-customer-name" id="selectedCustomerName">
                                Walk-in Customer
                            </div>
                            <div class="selected-customer-phone" id="selectedCustomerPhone">
                                <i class="bx bx-phone"></i>
                                <span>Customer umum / non member</span>
                            </div>
                        </div>
                        <div class="customer-selector-actions">
                            <span class="customer-badge" id="customerBadge">
                                UMUM
                            </span>
                            <button type="button" 
                                    class="btn-clear-customer" 
                                    id="clearCustomerBtn" 
                                    title="Clear customer"
                                    style="display: none;">
                                <i class="bx bx-x"></i>
                            </button>
                        </div>
                    </div>
                    
                    <!-- Hidden Search Dropdown -->
                    <div id="customerDropdown" class="customer-dropdown" style="display: none;">
                        <div class="customer-search-box">
                            <input type="text" class="form-control" id="customerSearchInput"
                                placeholder="Cari nama atau telepon customer..."
                                autocomplete="off">
                        </div>
                        <div class="customer-dropdown-header">
                            <small>↑ ↓ pilih • Enter pilih • Esc tutup</small>
                        </div>
                        <div id="customerResultsList" class="customer-dropdown-list">
                            <!-- Results will be populated by JS -->
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- input Promo Code -->
            <div class="pos-promo-section">
                <div class="input-promo-box">
                    <input type="text" class="form-control promo" placeholder="Promo Code">
                    <button type="button" class="btn btn-promo">Apply</button>
                </div>
            </div>
            <!-- Payment Section - Utama -->
            <div class="pos-payment-section">
                <button class="btn-checkout-large" id="completeOrderBtn">
                    <i class="bx bx-check-circle"></i>
                    <span>CHECKOUT / PAY</span>
                    <kbd>F4</kbd>
                </button>
                
                <div class="payment-methods">
                    <button class="btn-payment  btn-outline-primary" id="cashPaymentBtn">
                        <i class="bx bx-money"></i>
                        <span>Cash</span>
                        <kbd>F9</kbd>
                    </button>
                    <button class="btn-payment" id="cardPaymentBtn">
                        <i class="bx bx-credit-card"></i>
                        <span>Card</span>
                    </button>
                    <button class="btn-payment" id="qrisPaymentBtn">
                        <i class="bx bx-qr"></i>
                        <span>QRIS</span>
                    </button>
                    <button class="btn-payment" id="transferPaymentBtn">
                        <i class="bx bx-transfer"></i>
                        <span>Transfer</span>
                    </button>
                </div>
            </div>
            
            <!-- QUICK ACTIONS (Baru: fokus transaksi aktif) -->
            <div class="pos-quick-actions">
                <div class="quick-actions-title">
                    <i class="bx bx-flash"></i>
                    <span>Quick Actions</span>
                </div>
                <div class="quick-actions-grid">
                    <button class="quick-action-btn" id="holdTransactionBtn">
                        <i class="bx bx-save"></i>
                        <span>Hold</span>
                        <kbd>Ctrl+S</kbd>
                    </button>
                    <button class="quick-action-btn" id="resumeTransactionBtn">
                        <i class="bx bx-history"></i>
                        <span>Resume</span>
                        <kbd>Ctrl+H</kbd>
                    </button>
                    <button class="quick-action-btn btn-outline-danger" id="voidTransactionBtn">
                        <i class="bx bx-trash"></i>
                        <span>Void</span>
                        <kbd>F10</kbd>
                    </button>
                    <button class="quick-action-btn" id="refundBtn">
                        <i class="bx bx-undo"></i>
                        <span>Refund</span>
                        <kbd>Ctrl+R</kbd>
                    </button>
                    <button class="quick-action-btn" id="openDrawerBtn">
                        <i class="bx bx-door-open"></i>
                        <span>Open Drawer</span>
                        <kbd>Ctrl+O</kbd>
                    </button>
                </div>
            </div>
        </div>
    </div>
    
    <!-- ==================== MOBILE LAYOUT ==================== -->
    <div class="pos-mobile-layout">
        <!-- Mobile Header dengan Search -->
        <div class="mobile-header">
            <div class="mobile-search position-relative">
                <div class="input-group">
                    <span class="input-group-text bg-primary text-white border-0">
                        <i class="bx bx-barcode"></i>
                    </span>
                    <input type="text" 
                        class="form-control" 
                        id="mobileSearchProduct" 
                        placeholder="Scan barcode atau cari produk..." 
                        autocomplete="off">
                </div>
                <!-- Mobile Search Dropdown -->
                <div id="mobileSearchDropdown" class="search-dropdown-mobile" style="display: none;">
                    <div class="search-dropdown-header">
                        <small>↑ ↓ pilih &nbsp;&nbsp; Enter tambah &nbsp;&nbsp; Esc tutup</small>
                    </div>
                    <div id="mobileSearchResultsList" class="search-dropdown-list"></div>
                </div>
            </div>
        </div>
        
        <!-- Mobile Cart List -->
        <div class="mobile-cart-list" id="mobileCartItems">
            <!-- Akan diisi oleh JavaScript -->
        </div>
        
        <!-- Mobile Cart Summary -->
        <div class="mobile-cart-summary">
            <div class="mobile-summary-row mb-3">
                <span>Total</span>
                <span id="mobileTotal">Rp 0</span>
            </div>
        </div>

        <!-- Mobile Bottom Navigation -->
        <div class="mobile-bottom-nav">
            <button class="nav-item" id="mobileCartBtn">
                <i class="bx bx-cart"></i>
                <span>Cart</span>
                <span class="nav-badge" id="mobileCartCount">0</span>
            </button>
            <button class="nav-item" id="mobileCashBtn">
                <i class="bx bx-money"></i>
                <span>Cash</span>
            </button>
            <button class="nav-item" id="mobilePaymentBtn">
                <i class="bx bx-credit-card"></i>
                <span>Pay</span>
            </button>
            <button class="nav-item" id="mobileMenuNavBtn">
                <i class="bx bx-menu"></i>
                <span>Menu</span>
            </button>
        </div>
    </div>
    
    <!-- Slide Panel (Desktop & Mobile) dengan Dashboard di dalamnya -->
    <div class="pos-slide-overlay" id="slideOverlay"></div>
    <div class="pos-slide-panel" id="slidePanel">
        <div class="pos-slide-panel-header">
            <h5><i class="bx bx-cog"></i> Menu</h5>
            <button type="button" class="btn-close btn-close-white" id="closeSlidePanel"></button>
        </div>
        <div class="pos-slide-panel-body">
            <!-- NAVIGATION -->
            <div class="action-group mb-3">
                <div class="action-group-title">
                    <i class="bx bx-navigation"></i> Navigation
                </div>
                <div class="action-buttons">
                    <a href="/dashboard" class="action-btn with-arrow" style="text-decoration: none;">
                        <div class="action-btn-content">
                            <i class="bx bx-home"></i>
                            <span>Dashboard</span>
                        </div>
                        <i class="bx bx-chevron-right arrow-icon"></i>
                    </a>
                    <a href="/products" class="action-btn with-arrow" style="text-decoration: none;">
                        <div class="action-btn-content">
                            <i class="bx bx-package"></i>
                            <span>Products</span>
                        </div>
                        <i class="bx bx-chevron-right arrow-icon"></i>
                    </a>
                    <a href="/stock" class="action-btn with-arrow" style="text-decoration: none;">
                        <div class="action-btn-content">
                            <i class="bx bx-box"></i>
                            <span>Stock</span>
                        </div>
                        <i class="bx bx-chevron-right arrow-icon"></i>
                    </a>
                </div>
            </div>
            
            <!-- TRANSACTION MANAGEMENT -->
            <div class="action-group mb-3">
                <div class="action-group-title">
                    <i class="bx bx-receipt"></i> Transaction
                </div>
                <div class="action-buttons">
                    <button class="action-btn with-arrow" id="savedTransactionBtn">
                        <div class="action-btn-content">
                            <i class="bx bx-save"></i>
                            <span>Saved Sales</span>
                        </div>
                        <i class="bx bx-chevron-right arrow-icon"></i>
                    </button>
                    <a href="/sales" class="action-btn with-arrow" id="transactionHistoryBtn">
                        <div class="action-btn-content">
                            <i class="bx bx-history"></i>
                            <span>Sales History</span>
                        </div>
                        <i class="bx bx-chevron-right arrow-icon"></i>
                    </a>
                    <button class="action-btn with-arrow" id="reprintReceiptBtn">
                        <div class="action-btn-content">
                            <i class="bx bx-printer"></i>
                            <span>Reprint Receipt</span>
                        </div>
                        <i class="bx bx-chevron-right arrow-icon"></i>
                    </button>
                    <button class="action-btn with-arrow" id="clearCartBtnSlide">
                        <div class="action-btn-content">
                            <i class="bx bx-trash"></i>
                            <span>Clear Cart</span>
                        </div>
                        <i class="bx bx-chevron-right arrow-icon"></i>
                    </button>
                </div>
            </div>
            
            <!-- REPORTS -->
            <div class="action-group mb-3">
                <div class="action-group-title">
                    <i class="bx bx-chart"></i> Reports
                </div>
                <div class="action-buttons">
                    <button class="action-btn with-arrow" id="dailyReportBtnSlide">
                        <div class="action-btn-content">
                            <i class="bx bx-calendar"></i>
                            <span>Daily Report</span>
                        </div>
                        <i class="bx bx-chevron-right arrow-icon"></i>
                    </button>
                    <button class="action-btn with-arrow" id="xReadingBtnSlide">
                        <div class="action-btn-content">
                            <i class="bx bx-line-chart"></i>
                            <span>X-Reading</span>
                        </div>
                        <i class="bx bx-chevron-right arrow-icon"></i>
                    </button>
                    <button class="action-btn with-arrow" id="zReadingBtnSlide">
                        <div class="action-btn-content">
                            <i class="bx bx-bar-chart"></i>
                            <span>Z-Reading</span>
                        </div>
                        <i class="bx bx-chevron-right arrow-icon"></i>
                    </button>
                    <button class="action-btn with-arrow" id="bestSellerBtnSlide">
                        <div class="action-btn-content">
                            <i class="bx bx-trophy"></i>
                            <span>Best Seller</span>
                        </div>
                        <i class="bx bx-chevron-right arrow-icon"></i>
                    </button>
                    <button class="action-btn with-arrow" id="stockReportBtnSlide">
                        <div class="action-btn-content">
                            <i class="bx bx-package"></i>
                            <span>Stock Report</span>
                        </div>
                        <i class="bx bx-chevron-right arrow-icon"></i>
                    </button>
                </div>
            </div>
            
            <!-- SETTINGS -->
            <div class="action-group mb-3">
                <div class="action-group-title">
                    <i class="bx bx-cog"></i> Settings
                </div>
                <div class="action-buttons">
                    <button class="action-btn with-arrow" id="printerSettingsBtn">
                        <div class="action-btn-content">
                            <i class="bx bx-printer"></i>
                            <span>Printer</span>
                        </div>
                        <i class="bx bx-chevron-right arrow-icon"></i>
                    </button>
                    <button class="action-btn with-arrow" id="shiftSettingsBtn">
                        <div class="action-btn-content">
                            <i class="bx bx-briefcase"></i>
                            <span>Shift</span>
                        </div>
                        <i class="bx bx-chevron-right arrow-icon"></i>
                    </button>
                    <button class="action-btn with-arrow" id="userSettingsBtn">
                        <div class="action-btn-content">
                            <i class="bx bx-user"></i>
                            <span>User</span>
                        </div>
                        <i class="bx bx-chevron-right arrow-icon"></i>
                    </button>
                    <a href="/logout" class="action-btn btn-danger">
                        <i class="menu-icon tf-icons bx bx-power-off"></i>
                        <div data-i18n="Logout">Logout</div>
                    </a>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Scripts -->
    <script src="/assets/vendor/libs/jquery/jquery.js"></script>
    <script src="/assets/vendor/libs/popper/popper.js"></script>
    <script src="/assets/vendor/js/bootstrap.js"></script>
    <script src="/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
    <!-- <script src="/assets/js/pages/pos.js"></script> -->
    <script type="module" src="/assets/js/pos/index.js"></script>
</body>
</html>