<link rel="stylesheet" href="/assets/css/reports-compact.css">

<div class="container-xxl flex-grow-1 container-p-y print-area">
    <div class="d-flex justify-content-between align-items-center mb-3 no-print">
        <h4 class="fw-bold py-3 mb-0"><span class="text-muted fw-light">Reports /</span> Payment Methods</h4>
        <div class="d-flex gap-2">
            <button class="btn btn-primary btn-sm" onclick="window.print()">
                <i class="bx bx-printer me-1"></i> Print
            </button>
        </div>
    </div>
    
    <div class="d-none d-print-block mb-3">
        <h4>Laporan Metode Pembayaran</h4>
        <p>Periode: <%= filters.dateFrom %> s/d <%= filters.dateTo %></p>
    </div>

    <!-- Filter Section -->
    <div class="filter-section mb-4 no-print">
        <form id="filterForm" class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Date From</label>
                <input type="date" name="dateFrom" class="form-control form-control-sm" value="<%= filters.dateFrom %>">
            </div>
            <div class="col-md-4">
                <label class="form-label">Date To</label>
                <input type="date" name="dateTo" class="form-control form-control-sm" value="<%= filters.dateTo %>">
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="bx bx-filter-alt me-1"></i> Filter
                </button>
            </div>
        </form>
    </div>

    <div class="row">
        <!-- Chart -->
        <div class="col-md-6 mb-4">
            <div class="card h-100 report-card">
                <div class="card-body d-flex flex-column align-items-center justify-content-center">
                    <canvas id="paymentChart" height="300"></canvas>
                </div>
            </div>
        </div>

        <!-- Table -->
        <div class="col-md-6 mb-4">
            <div class="card h-100 report-card">
                <div class="table-responsive text-nowrap">
                    <table class="table table-compact table-hover">
                        <thead>
                            <tr>
                                <th>Method</th>
                                <th class="text-center">Transactions</th>
                                <th class="text-end">Total Amount</th>
                                <th class="text-end">Percentage</th>
                            </tr>
                        </thead>
                        <tbody id="reportTableBody">
                            <% 
                                const grandTotal = payments.reduce((sum, p) => sum + parseFloat(p.get('totalAmount')), 0);
                            %>
                            <% payments.forEach(p => { %>
                            <tr>
                                <td><strong><%= p.paymentMethod.toUpperCase() %></strong></td>
                                <td class="text-center"><%= p.get('count') %></td>
                                <td class="text-end fw-bold"><%= formatRupiah(p.get('totalAmount')) %></td>
                                <td class="text-end">
                                    <%= ((parseFloat(p.get('totalAmount')) / grandTotal) * 100).toFixed(1) %>%
                                </td>
                            </tr>
                            <% }) %>
                            <% if (payments.length === 0) { %>
                                <tr><td colspan="4" class="text-center py-4">No data found</td></tr>
                            <% } %>
                        </tbody>
                        <% if (payments.length > 0) { %>
                        <tfoot>
                            <tr class="table-light">
                                <th>GRAND TOTAL</th>
                                <th class="text-center"><%= payments.reduce((sum, p) => sum + parseInt(p.get('count')), 0) %></th>
                                <th class="text-end"><%= formatRupiah(grandTotal) %></th>
                                <th class="text-end">100%</th>
                            </tr>
                        </tfoot>
                        <% } %>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
let myChart;

document.addEventListener('DOMContentLoaded', function() {
    renderChart(<%- JSON.stringify(payments) %>);
});

document.getElementById('filterForm').addEventListener('submit', function(e) {
    e.preventDefault();
    const params = new URLSearchParams(new FormData(this)).toString();
    
    fetch('/reports/payments?ajax=1&' + params)
        .then(res => res.json())
        .then(data => {
            location.reload(); // Simple reload for this one to update table with calculated totals
        });
});

function renderChart(payments) {
    const ctx = document.getElementById('paymentChart').getContext('2d');
    if (myChart) myChart.destroy();

    myChart = new Chart(ctx, {
        type: 'pie',
        data: {
            labels: payments.map(p => p.paymentMethod.toUpperCase()),
            datasets: [{
                data: payments.map(p => p.totalAmount),
                backgroundColor: ['#696cff', '#03c3ec', '#71dd37', '#ff3e1d', '#ffab00']
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { position: 'bottom' }
            }
        }
    });
}
</script>